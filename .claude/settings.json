{
  "permissions": {
    "allow": [
      "Skill(*)",
      "Edit(.claude/skills/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File .claude/skills/run-checks/pre-commit-hook.ps1",
            "timeout": 600,
            "statusMessage": "Running checks before commit/push…"
          }
        ]
      }
    ]
  }
}
