[resource]
default_font = ExtResource("1_font")
default_font_size = 20
Button/colors/font_color = Color(0.85, 0.91, 0.98, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(0.6, 0.82, 1, 1)
Button/colors/font_disabled_color = Color(0.5, 0.55, 0.62, 1)
Button/colors/font_focus_color = Color(1, 1, 1, 1)
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_focus")
Label/colors/font_color = Color(0.88, 0.92, 0.97, 1)
Panel/styles/panel = SubResource("panel_bg")
PanelContainer/styles/panel = SubResource("panel_bg")
HSeparator/constants/separation = 6
HSeparator/styles/separator = SubResource("sep_line")
VSeparator/constants/separation = 6
VSeparator/styles/separator = SubResource("sep_line")
ProgressBar/styles/background = SubResource("pbar_bg")
ProgressBar/styles/fill = SubResource("pbar_fill")
