[gd_resource type="Theme" load_steps=11 format=3 uid="uid://b1nwo_theme"]

; NWO global UI theme — dark sci-fi.
; Palette is concentrated in the StyleBoxFlat colors below so it stays tunable in
; one place (mirrors the "constants in one file" pattern used elsewhere).
;   panel bg     Color(0.07, 0.09, 0.14)   deep slate-blue
;   accent       Color(0.36, 0.64, 0.88)   cool cyan-blue rim/glow
;   text         Color(0.88, 0.92, 0.97)   soft off-white
; Wired globally via project.godot [gui] theme/custom; applies to every Control.

[ext_resource type="FontFile" path="res://assets/fonts/PixelOperator.ttf" id="1_font"]

[sub_resource type="StyleBoxFlat" id="panel_bg"]
bg_color = Color(0.07, 0.09, 0.14, 0.92)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.36, 0.64, 0.88, 0.85)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
content_margin_left = 8.0
content_margin_top = 6.0
content_margin_right = 8.0
content_margin_bottom = 6.0

